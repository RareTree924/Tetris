# Board settings (same as CaptureIt): ESP32-S3, 16 MB flash, 8 MB octal PSRAM.
# Only read when there's no sdkconfig yet — delete sdkconfig to re-apply.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM holds the 480x480 framebuffer
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=y

# Long file names on the SD card (sound files)
CONFIG_FATFS_LFN_HEAP=y

# Logs on both UART and the USB port
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# 1 ms ticks, so vTaskDelay(pdMS_TO_TICKS(16)) really waits 16 ms
CONFIG_FREERTOS_HZ=1000
